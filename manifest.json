{
  "manifest_version": 3,
  "name": "Captain Pin Board",
  "version": "1.1.0",
  "description": "Pin messages into collections such as Marketing or Scripts and find them again in one click.",
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "scripting", "activeTab", "clipboardRead"],
  "action": {
    "default_popup": "src/pages/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/services/background.js"
  },
  "commands": {
    "open_full_board": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Open the full board"
    },
    "capture_area": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Capture an area to pin"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
