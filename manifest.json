{
  "manifest_version": 3,
  "name": "Captain Pin Board",
  "version": "1.0.0",
  "description": "Pin messages into collections such as Marketing or Scripts and find them again in one click.",
  "permissions": ["storage", "contextMenus", "scripting", "activeTab"],
  "action": {
    "default_popup": "src/pages/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/services/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
