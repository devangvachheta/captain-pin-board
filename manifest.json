{
  "manifest_version": 3,
  "name": "Captain Pin Board",
  "version": "1.2.0",
  "description": "Pin messages into collections such as Marketing or Scripts and find them again in one click.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "scripting",
    "activeTab",
    "clipboardRead"
  ],
  "action": {
    "default_popup": "src/pages/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/services/background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      }
    },
    "capture_area": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Capture an area to pin"
    },
    "open_full_board": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Open the full board"
    },
    "quick_search": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Quick find and copy a pin"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
